# ---------------------------------------------------------------------------
# Arquivo de exemplo de configuracao do CMS Valley Bot
#
# Copie este arquivo para .env e preencha os valores reais.
# O arquivo .env nunca deve ir para o Git (ja esta no .gitignore).
# ---------------------------------------------------------------------------

# Token do bot, pego no Discord Developer Portal. Obrigatorio.
DISCORD_TOKEN=

# ID do servidor principal onde os comandos sao sincronizados. Obrigatorio.
GUILD_ID=1325206480516808745

# ID do servidor CMS Valley usado pelos sistemas de plantao e chamada.
GUILD_ID_VALLEY=1035704096608493608

# Endereco de conexao com o PostgreSQL. Obrigatorio.
# Formato: postgresql+asyncpg://usuario:senha@servidor:porta/banco
DATABASE_URL=

# Pasta onde os backups em JSON sao gravados.
BACKUP_DIR=src/data/backups

# Quantos backups manter por servidor antes de apagar os mais antigos.
MAX_BACKUPS_PER_GUILD=10

# De quantas em quantas horas o backup automatico de cargos roda.
AUTO_BACKUP_INTERVAL_HOURS=24

# De quantos em quantos minutos o backup automatico do banco roda.
AUTO_BACKUP_DB_INTERVAL_MINUTES=360

# Nomes dos cargos que contam como administrador, separados por virgula.
ADMIN_ROLE_NAMES=Responsavel HP,[ CMS ]

# Quantos segundos um pedido de confirmacao espera antes de expirar.
CONFIRMATION_TIMEOUT=30

# Discord IDs sempre preservados no /moderacao wipe (alem dos cargos de gestao).
# Separados por virgula. Opcional.
IDS_PRESERVADOS_NO_WIPE=
BACKUP_API_TOKEN=a7f3c9e2b4d8f1a6c3e5b7d9f0a2c4e6b8d0f2a4c6e8b0d2f4a6c8e0b2d4f6a8
KEEPALIVE_INTERVALO_MINUTOS=10
SCREENSHARE_API_URL=https://ems-ocr-api.onrender.com
SCREENSHARE_EXPIRA_EM=1d
SCREENSHARE_KEEPALIVE_MINUTOS=3
SCREENSHARE_MAX_PARTICIPANTES=4
SCREENSHARE_MAX_USOS=unlimited
SCREENSHARE_PUBLIC_URL=https://cmsvalley-api.vercel.app/screenshare
TRANSCRIPT_SITE_URL=https://cmsvalley-api.vercel.app
CMSVALLEY_API_URL=https://ems-ocr-api.onrender.com
EMS_OCR_API_URL=https://ems-ocr-api.onrender.com/ocr
EMS_OCR_KEEPALIVE_URL=https://ems-ocr-api.onrender.com/
